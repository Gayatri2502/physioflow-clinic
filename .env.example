# Firebase web configuration is public, not an Admin credential.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=physioflow-clinic-20261013.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=physioflow-clinic-20261013
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=physioflow-clinic-20261013
FIREBASE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=physioflow-clinic-20261013.firebasestorage.app
FIREBASE_CLINIC_ID=physioflow
CLINIC_OWNER_EMAIL=alphacentauric.ai@gmail.com
# Production App Hosting uses application default credentials. For local server work:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/to/service-account.json
# Do not commit service account JSON or set Admin credentials in NEXT_PUBLIC variables.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VAPI_ENABLED=false
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Automatic sends stay disabled until a configured test deployment passes end-to-end checks.
WHATSAPP_AUTOMATIC_REMINDERS_ENABLED=false
WHATSAPP_REMINDER_LEAD_HOURS=24
WHATSAPP_REMINDER_WINDOW_MINUTES=60
WHATSAPP_REMINDER_BATCH_SIZE=5
# Generate a separate random secret of at least 32 characters for the external cron job.
REMINDER_JOB_SECRET=
